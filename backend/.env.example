# Copy this file to .env and fill in your own values

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/url-shortener
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/url-shortener
MONGO_URI=mongodb://127.0.0.1:27017/url-shortener

# Port the Express API server listens on
PORT=5000

# Base URL used to build the short links returned to the client
# In production, set this to your real domain, e.g. https://snip.example.com
BASE_URL=http://localhost:5000

# Origin allowed to call the API (the React dev server by default)
CLIENT_ORIGIN=http://localhost:5173
